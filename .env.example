# Copy to .env.local and fill in. Never commit real values.
# Server-only variables have no NEXT_PUBLIC_ prefix and are read only under src/server/.

# Supabase (new-style keys: publishable for the browser, secret for the server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# App (public base URL; previews fall back to https://$VERCEL_URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM=Metalira Ops <dipo@metaliratech.com>

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Random string that gates the Sentry test-error route
SENTRY_TEST_TOKEN=

# Flutterwave (Metalira's own test account only; each customer's credentials are stored encrypted per organisation)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# Column-level encryption for personal data (NIN, BVN, bank account, RSA PIN). 32 random bytes, base64. Phase 1.
PII_ENCRYPTION_KEY=
